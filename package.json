{
  "name": "hnbcrm",
  "private": true,
  "version": "0.80.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite --open",
    "dev:backend": "convex dev",
    "build": "vite build",
    "lint": "tsc -p convex -noEmit --pretty false && tsc -p tsconfig.app.json -noEmit --pretty false && tsc -p tsconfig.node.json -noEmit --pretty false && convex dev --once && vite build",
    "test": "vitest run",
    "deploy:prod": "sh -c 'f=convex-prod-key.env.local; [ -s \"$f\" ] || { echo \"deploy:prod: $f ausente ou vazio (chave do deploy PROD)\" >&2; exit 1; }; k=$(sed -n \"s/^CONVEX_DEPLOY_KEY=//p\" \"$f\" | head -n1); [ -n \"$k\" ] || k=$(head -n1 \"$f\"); k=$(printf %s \"$k\" | tr -d \"\\\"\\r \"); case \"$k\" in prod:*) ;; *) echo \"deploy:prod: a chave em $f não começa com prod: — recusando\" >&2; exit 1;; esac; CONVEX_DEPLOY_KEY=\"$k\" npx convex deploy -y'",
    "build:embed": "vite build --config vite.embed.config.ts",
    "convert-images": "node scripts/convert-images.js"
  },
  "dependencies": {
    "@auth/core": "^0.37.0",
    "@convex-dev/auth": "^0.0.80",
    "@convex-dev/resend": "^0.2.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "clsx": "^2.1.1",
    "convex": "^1.31.2",
    "convex-helpers": "^0.1.112",
    "lucide-react": "^0.564.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-helmet-async": "^2.0.5",
    "react-router": "^7.13.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.1.0",
    "tinyld": "^1.3.4",
    "web-push": "3.6.7",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-window": "7.4.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.21.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/web-push": "3.6.4",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "~10",
    "convex-test": "0.0.41",
    "dotenv": "^16.4.7",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^30.1.3",
    "npm-run-all": "^4.1.5",
    "postcss": "~8",
    "prettier": "^3.5.3",
    "rollup-plugin-visualizer": "^6.0.5",
    "sharp": "^0.34.5",
    "tailwindcss": "~3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^4.1.10",
    "workbox-build": "7.4.1"
  }
}
